# Настройки службы «Адресный склад запчастей».
# После изменения: sudo systemctl restart parts-yard

# Адрес и порт (jac-yard работает отдельно, на своём порту)
WMS_BIND=0.0.0.0
WMS_PORT=8090

# База и топология склада
WMS_DB=/var/lib/parts-yard/warehouse.db
WMS_LAYOUT=/etc/parts-yard/layout.json

# 1 — администратор видит кнопку «Сбросить демо-данные». Для реальной работы поставьте 0.
WMS_DEMO=1

# Сессии: имя cookie и срок жизни в днях. Имя отличается от jac.sid,
# чтобы сессии склада и площадки не пересекались на одном домене.
WMS_COOKIE=pyard.sid
WMS_SESSION_DAYS=14

# За nginx с HTTPS включите оба параметра и поставьте WMS_BIND=127.0.0.1
WMS_TRUST_PROXY=0
WMS_SECURE_COOKIE=0

# Интеграция с Carsale (app.carsale.uz): каталог и остатки центрального склада, только чтение.
# Лучше отдельный пользователь Carsale с правом только на просмотр запчастей.
# После изменения: sudo systemctl restart parts-yard, проверка: sudo parts-yard carsale-sync
CARSALE_URL=https://crm.carsale.uz
CARSALE_LOGIN=
CARSALE_PASSWORD=
# филиал определяется сам; задайте, если у пользователя их несколько
CARSALE_FILIAL=
